Proceso Calculadora
    Definir a, b, suma, resta Como Entero
    
    Escribir "Ingrese el primer numero:"
    Leer a
    
    Escribir "Ingrese el segundo numero:"
    Leer b
    
    suma <- a + b
    resta <- a - b
    
    Escribir "La suma es: ", suma
    Escribir "La resta es: ", resta
FinProceso